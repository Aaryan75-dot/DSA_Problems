class Solution {
    public void segregateElements(int[] arr) {
        // Your code goes here
        
        ArrayList<Integer> positiveNumber = new ArrayList<>();
        ArrayList<Integer> negativeNumber = new ArrayList<>();
        
        for(int i = 0;i<arr.length;i++){
            if(arr[i] >= 0) positiveNumber.add(arr[i]);
            else negativeNumber.add(arr[i]);
        }
        
        for(int i= 0;i<positiveNumber.size();i++){
            arr[i] = positiveNumber.get(i);
        }
        
        for(int j = 0;j<negativeNumber.size();j++){
            arr[positiveNumber.size() + j] = negativeNumber.get(j);
        }
        
    }
}
