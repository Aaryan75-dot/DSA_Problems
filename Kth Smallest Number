class Solution {
    public static int kthSmallest(int[] arr, int k) {
        // Your code here
        for(int i = 0;i<arr.length;i++){
            for(int j = 0;j<arr.length-1;j++){
                if(arr[j] > arr[j+1]){
                    int tem = arr[j];
                    arr[j] = arr[j+1];
                    arr[j+1] = tem;
                }
            }
        }
        
        return arr[k-1];
    }
}


// Using Priority Queue

class Solution {
    public static int kthSmallest(int[] arr, int k) {
        // Your code here
        
       PriorityQueue<Integer> queue = new PriorityQueue<>();
       
       for(int i = 0;i<arr.length;i++){
           queue.add(arr[i]);
       }
       
       int count = 0;
       int res = 0;
       
       while(count < k){
         res = queue.poll();   
         count++;
       }
       
       return res;
    }
}
